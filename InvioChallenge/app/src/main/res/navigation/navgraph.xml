<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navgraph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.eliftekin.inviochallenge.fragments.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.eliftekin.inviochallenge.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_cityMapFragment"
            app:destination="@id/cityMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.eliftekin.inviochallenge.fragments.DetailsFragment"
        android:label="fragment_details"
        tools:layout="@layout/fragment_details">
        <argument
            android:name="locationDetail"
            app:argType="com.eliftekin.inviochallenge.model.LocationsList"
            app:nullable="false"/>
        <action
            android:id="@+id/action_detailsFragment_to_locationMapFragment"
            app:destination="@id/locationMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/locationMapFragment"
        android:name="com.eliftekin.inviochallenge.fragments.LocationMapFragment"
        android:label="fragment_location_map"
        tools:layout="@layout/fragment_location_map">
        <argument
            android:name="locationDetail"
            app:argType="com.eliftekin.inviochallenge.model.LocationsList"
            app:nullable="false"/>
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.eliftekin.inviochallenge.fragments.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites" >
        <argument
            android:name="locationDetail"
            app:argType="com.eliftekin.inviochallenge.model.LocationsList"
            app:nullable="false"/>
        <action
            android:id="@+id/action_favoritesFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cityMapFragment"
        android:name="com.eliftekin.inviochallenge.fragments.CityMapFragment"
        android:label="fragment_city_map"
        tools:layout="@layout/fragment_city_map">
        <argument
            android:name="cityDetail"
            app:argType="com.eliftekin.inviochallenge.model.DataList"
            app:nullable="false"/>
        <action
            android:id="@+id/action_cityMapFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
</navigation>